{
  "name": "openscad",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "OpenSCAD MCP server and browser powered by openscad-wasm.",
  "license": "MIT",
  "workspaces": [
    "mcp",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w mcp && npm run build -w web",
    "build:mcp": "npm run build -w mcp",
    "build:web": "npm run build -w web",
    "check:docs": "node scripts/check-docs.mjs",
    "dev": "npm run dev -w mcp",
    "dev:stdio": "npm run dev:stdio -w mcp",
    "format": "prettier --write .",
    "lint": "eslint .",
    "mcp:inspector": "mcp/scripts/mcp-inspector.sh",
    "prepare:assets": "npm run prepare:assets -w web",
    "pretest": "npm run build:mcp",
    "start": "npm run start -w mcp",
    "start:stdio": "npm run start:stdio -w mcp",
    "test": "vitest run",
    "test:browser": "npm run test:browser -w web",
    "test:docs": "node --test scripts/check-docs.test.mjs",
    "typecheck": "npm run typecheck -w mcp && npm run typecheck -w web",
    "validate:openspec": "npx --yes @fission-ai/openspec@1.16.0 validate --all --strict"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.1.0",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "dompurify": "^3.4.17"
  }
}
