PORT=3333
HOST=0.0.0.0
WORKSPACE_DIR=/workspace
# WEB_DIR=/app/web/dist
MAX_RENDER_MS=30000
MAX_OUTPUT_MB=50
MAX_INPUT_MB=50
MAX_PARALLEL_JOBS=2
OPENSCAD_BACKEND=wasm
